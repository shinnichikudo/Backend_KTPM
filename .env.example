# Local Docker Compose credentials. Copy this file to .env and change these values.
MYSQL_ROOT_PASSWORD=change_this_local_root_password
MYSQL_USER=booking_app
MYSQL_PASSWORD=change_this_local_app_password
# Optional: Port MySQL map ra may ngoai (mac dinh 3308 de tranh trung 3306/3307)
MYSQL_HOST_PORT=3308

# Required: JWT Secret key dung de ky token (toi thieu 32 ky tu / 256 bits cho HMAC-SHA)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters_long

# Optional: seed an ADMIN user when the app starts.
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=ChangeMe123!
